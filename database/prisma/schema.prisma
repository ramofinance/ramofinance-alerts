generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum MarketType {
  FOREX
  CRYPTO
  STOCK
  INDEX
  COMMODITY
}

enum AlertDirection {
  ABOVE
  BELOW
  CROSSING_UP
  CROSSING_DOWN
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  PAUSED
  CANCELLED
  EXPIRED
}

enum SubscriptionStatus {
  ACTIVE
  TRIAL
  EXPIRED
  CANCELLED
}

enum PreferredLanguage {
  FA
  EN
  AR
  ES
  ZH
}

enum TelegramNotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model User {
  id                               String             @id @default(uuid())
  telegramId                       String?            @unique
  username                         String?
  firstName                        String?
  lastName                         String?
  languageCode                     String?
  preferredLanguage                PreferredLanguage?
  role                             UserRole           @default(USER)
  isActive                         Boolean            @default(true)
  miniAppOpenCount                 Int                @default(0)
  botStartCount                    Int                @default(0)
  firstBotStartedAt                DateTime?
  lastBotStartedAt                 DateTime?
  firstMiniAppOpenedAt             DateTime?
  lastMiniAppOpenedAt              DateTime?
  lastSeenAt                       DateTime?
  alertNotificationRepeatCount     Int                @default(1)
  alertNotificationIntervalSeconds Int                @default(60)
  radarNotificationsEnabled        Boolean            @default(false)
  radarMinimumScore                Int                @default(75)
  radarMinMarketCap                Float              @default(3000000)
  radarMaxMarketCap                Float?
  radarMinTurnoverPercent          Float              @default(15)
  radarMinVolumeAcceleration       Float?
  radarMinPriceChange24h           Float?
  radarMinTradeCount24h            Int?
  radarMinTurnover72hPercent       Float              @default(0)
  radarMinBuyImbalancePercent      Float              @default(0)
  radarMinWhaleBuyVolumeUsd        Float              @default(0)
  radarMinBidWallImbalancePercent  Float              @default(0)
  radarMinOpenInterestChangePercent Float             @default(0)
  radarMinDexTurnoverPercent       Float              @default(0)
  radarMinDexLiquidityUsd          Float              @default(0)
  radarMinDexBuyImbalancePercent   Float              @default(0)
  radarMinShortLiquidationUsd      Float              @default(0)
  radarMaxFundingRatePercent       Float              @default(0)
  radarMinOnchainWhaleUsd          Float              @default(0)
  radarMinExchangeOutflowUsd       Float              @default(0)
  radarMinCexConfirmations         Int                @default(0)
  radarMinChannelConfirmations     Int                @default(0)
  radarPreviewAccess               Boolean            @default(false)
  createdAt                        DateTime           @default(now())
  updatedAt                        DateTime           @updatedAt

  alerts             Alert[]
  subscriptions      Subscription[]
  favoriteMarkets    UserMarketFavorite[]
  notificationJobs   TelegramAlertNotification[]
  radarNotifications RadarNotification[]

  @@index([telegramId])
  @@index([username])
  @@index([lastSeenAt])
}

model RadarAccessInvite {
  id               String    @id @default(uuid())
  token            String    @unique
  createdByUserId  String
  redeemedByUserId String?
  expiresAt        DateTime
  redeemedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([token, expiresAt])
  @@index([createdByUserId])
}

model RadarSignal {
  id                 String   @id @default(uuid())
  symbol             String
  score              Int
  direction          String
  price              Decimal
  marketCap          Decimal?
  volume24h          Decimal?
  turnover24h        Float?
  priceChange24h     Float?
  volumeAcceleration Float?
  tradeCount24h      Int?
  volume72h          Decimal?
  turnover72h        Float?
  buySellImbalance   Float?
  whaleBuyVolumeUsd  Decimal?
  whaleSellVolumeUsd Decimal?
  whaleTradeCount    Int?
  bidWallImbalance   Float?
  openInterestChange Float?
  fundingRate        Float?
  shortLiquidationUsd Decimal?
  longLiquidationUsd Decimal?
  dexVolume24h       Decimal?
  dexLiquidityUsd    Decimal?
  dexTurnover24h     Float?
  dexBuySellImbalance Float?
  cexConfirmations   Int      @default(0)
  channelConfirmations Int    @default(0)
  channelMentions    Json?
  onchainWhaleUsd    Decimal?
  exchangeOutflowUsd Decimal?
  exchangeInflowUsd  Decimal?
  chainId            String?
  dexUrl             String?
  sourceSummary      String
  reasons            Json
  cooldownKey        String   @unique
  detectedAt         DateTime @default(now())
  createdAt          DateTime @default(now())

  notifications RadarNotification[]

  @@index([detectedAt])
  @@index([score, detectedAt])
  @@index([symbol, detectedAt])
}

model RadarNotification {
  id          String                     @id @default(uuid())
  signalId    String
  userId      String
  telegramId  String
  message     String
  status      TelegramNotificationStatus @default(PENDING)
  attempts    Int                        @default(0)
  lastError   String?
  scheduledAt DateTime                   @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  signal RadarSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([signalId, userId])
  @@index([status, scheduledAt])
  @@index([userId])
}

model Market {
  id         String     @id @default(uuid())
  symbol     String     @unique
  name       String?
  type       MarketType
  baseAsset  String?
  quoteAsset String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  alerts       Alert[]
  latestPrice  MarketPrice?
  priceHistory MarketPriceHistory[]
  favoritedBy  UserMarketFavorite[]

  @@index([symbol])
  @@index([type])
}

model UserMarketFavorite {
  userId    String
  marketId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@id([userId, marketId])
  @@index([marketId])
  @@index([userId, createdAt])
}

model MarketPrice {
  id        String   @id @default(uuid())
  marketId  String   @unique
  price     Decimal
  source    String   @default("manual")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([updatedAt])
}

model MarketPriceHistory {
  id         String   @id @default(uuid())
  marketId   String
  price      Decimal
  source     String   @default("manual")
  observedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id], onDelete: Cascade)

  @@index([marketId])
  @@index([marketId, observedAt])
  @@index([observedAt])
}

model Alert {
  id          String         @id @default(uuid())
  userId      String
  marketId    String
  title       String?
  targetPrice Decimal
  direction   AlertDirection
  status      AlertStatus    @default(ACTIVE)
  triggeredAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  market           Market                      @relation(fields: [marketId], references: [id], onDelete: Cascade)
  notificationJobs TelegramAlertNotification[]

  @@index([userId])
  @@index([marketId])
  @@index([status])
  @@index([direction])
}

model TelegramAlertNotification {
  id          String                     @id @default(uuid())
  alertId     String
  userId      String
  telegramId  String
  message     String
  sequence    Int
  totalCount  Int
  scheduledAt DateTime
  status      TelegramNotificationStatus @default(PENDING)
  attempts    Int                        @default(0)
  lastError   String?
  lockedAt    DateTime?
  sentAt      DateTime?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertId, sequence])
  @@index([status, scheduledAt])
  @@index([userId])
}

model Line {
  id        String   @id @default(uuid())
  userId    String?
  marketId  String?
  label     String?
  price     Decimal
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([marketId])
}

model Subscription {
  id        String             @id @default(uuid())
  userId    String
  plan      String
  status    SubscriptionStatus @default(TRIAL)
  startsAt  DateTime           @default(now())
  endsAt    DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
