NODE_ENV=development

BACKEND_PORT=3000
FRONTEND_PORT=5173

DATABASE_URL=postgresql://ramofinance:ramofinance@localhost:5432/ramofinance_alerts
DIRECT_URL=postgresql://ramofinance:ramofinance@localhost:5432/ramofinance_alerts

JWT_SECRET=
WS_PORT=4000

VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_CRYPTOFLOW_URL=https://cryptoflow.ramo-fin-group.workers.dev/
# Keep unfinished signal and investment banners hidden.
VITE_UPCOMING_SERVICES_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=ramofinance_alerts_bot
TELEGRAM_WEBAPP_URL=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated, without @. Matching users are promoted when they start/open the app.
TELEGRAM_ADMIN_USERNAMES=ramoadmin
TELEGRAM_ADMIN_IDS=111287296
CRYPTOFLOW_URL=https://cryptoflow.ramo-fin-group.workers.dev/
ALLOWED_ORIGINS=

# Billing infrastructure stays dormant. Keep false until a future paid release.
BILLING_ENABLED=false

PRICE_POLLING_ENABLED=false
PRICE_POLLING_INTERVAL_MS=30000

# The radar remains admin-only while RADAR_PUBLIC_ENABLED is false.
RADAR_ENABLED=true
RADAR_PUBLIC_ENABLED=false
RADAR_SCAN_INTERVAL_MS=120000
RADAR_SIGNAL_THRESHOLD=68
